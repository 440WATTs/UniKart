# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for institute email codes, account deletion and scripts.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_INSTITUTE_ID=nit-sikkim

# --- Google sign-in -----------------------------------------------------------
# Set to true only after enabling the Google provider in Supabase Auth
# (docs/SETUP.md §3). The Google client ID/secret live in Supabase, not here.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- Institute email verification ------------------------------------------
# Random secret used to hash verification codes: openssl rand -hex 32
VERIFICATION_CODE_SECRET=
# Email provider (Resend). Without these, development prints codes to the
# server console and production refuses to send.
RESEND_API_KEY=
EMAIL_FROM="UniKart <verify@your-domain.example>"

# --- Development only -------------------------------------------------------
# Allows `npm run seed` / `npm run seed:reset`. Never set in production.
ALLOW_DEMO_SEED=false
