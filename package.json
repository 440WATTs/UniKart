{
  "name": "unikart",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:db": "node --import tsx --test tests/db/schema.test.ts",
    "seed": "node --env-file=.env.local --import tsx scripts/seed-demo.ts",
    "seed:reset": "node --env-file=.env.local --import tsx scripts/seed-demo.ts --reset",
    "make-admin": "node --env-file=.env.local --import tsx scripts/make-admin.ts",
    "landing": "python3 scripts/build-landing.py",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test": "npm run test:unit && npm run test:db",
    "preview:build": "python3 scripts/build-preview.py"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "next": "^15.5.28",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.28",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.31"
    }
  }
}
